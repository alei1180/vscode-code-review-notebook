{
  "name": "vscode-code-review-notes",
  "displayName": "Code Review Notes",
  "description": "Manual code reviews with local notes and Markdown or PDF reports.",
  "version": "0.1.23",
  "private": true,
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=24"
  },
  "main": "./dist/extension.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alei1180/vscode-code-review-notes.git"
  },
  "bugs": {
    "url": "https://github.com/alei1180/vscode-code-review-notes/issues"
  },
  "homepage": "https://github.com/alei1180/vscode-code-review-notes#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "code review",
    "review notes",
    "markdown",
    "pdf"
  ],
  "scripts": {
    "build": "node scripts/clean.cjs && tsc -p . && node scripts/build.cjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test out/test/*.test.js && node scripts/test-bundle.cjs && node scripts/test-commands.cjs && node scripts/test-open-report.cjs",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "package:list": "vsce ls --no-dependencies",
    "test:integration": "npm run build && node scripts/integration.cjs"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.20.3",
    "@types/pdfkit": "0.17.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "jsdom": "30.1.0",
    "npm": "12.0.2",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "lowlight": "3.3.0",
    "pdfkit": "0.20.2",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.5"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Review notes require a trusted local project."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Only local files are supported."
    }
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:codeReviewNotes.reviews"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeReviewNotes.start",
        "title": "%command.start%",
        "category": "Code Review Notes",
        "icon": "$(add)"
      },
      {
        "command": "codeReviewNotes.add",
        "title": "%command.add%",
        "category": "Code Review Notes",
        "icon": "$(comment-add)"
      },
      {
        "command": "codeReviewNotes.complete",
        "title": "%command.complete%",
        "category": "Code Review Notes",
        "icon": "$(check)"
      },
      {
        "command": "codeReviewNotes.select",
        "title": "%command.select%",
        "category": "Code Review Notes",
        "icon": "$(check)"
      },
      {
        "command": "codeReviewNotes.editReview",
        "title": "%command.editReview%",
        "category": "Code Review Notes",
        "icon": "$(edit)"
      },
      {
        "command": "codeReviewNotes.copy",
        "title": "%command.copy%",
        "category": "Code Review Notes",
        "icon": "$(copy)"
      },
      {
        "command": "codeReviewNotes.export",
        "title": "%command.export%",
        "category": "Code Review Notes",
        "icon": "$(export)"
      },
      {
        "command": "codeReviewNotes.openNote",
        "title": "%command.openNote%",
        "category": "Code Review Notes",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codeReviewNotes.viewNote",
        "title": "%command.viewNote%",
        "category": "Code Review Notes",
        "icon": "$(preview)"
      },
      {
        "command": "codeReviewNotes.editNote",
        "title": "%command.editNote%",
        "category": "Code Review Notes",
        "icon": "$(edit)"
      },
      {
        "command": "codeReviewNotes.deleteNote",
        "title": "%command.deleteNote%",
        "category": "Code Review Notes",
        "icon": "$(trash)"
      },
      {
        "command": "codeReviewNotes.addGeneral",
        "title": "%command.addGeneral%",
        "category": "Code Review Notes",
        "icon": "$(comment)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeReviewNotes",
          "title": "Code Review Notes",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "codeReviewNotes": [
        {
          "id": "codeReviewNotes.reviews",
          "name": "%view.reviews%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeReviewNotes.reviews",
        "contents": "%view.welcome%"
      }
    ],
    "keybindings": [
      {
        "command": "codeReviewNotes.add",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ],
    "configuration": {
      "title": "Code Review Notes",
      "properties": {
        "codeReviewNotes.language": {
          "type": "string",
          "enum": [
            "en",
            "ru"
          ],
          "enumDescriptions": [
            "English",
            "Русский"
          ],
          "default": "en",
          "scope": "application",
          "description": "%setting.language%"
        },
        "codeReviewNotes.reportFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "pdf",
            "both"
          ],
          "default": "markdown",
          "description": "%setting.format%"
        },
        "codeReviewNotes.reportDirectory": {
          "type": "string",
          "default": "Code Review Note",
          "description": "%setting.directory%"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "codeReviewNotes.start",
          "when": "view == codeReviewNotes.reviews",
          "group": "navigation"
        },
        {
          "command": "codeReviewNotes.addGeneral",
          "when": "view == codeReviewNotes.reviews",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "codeReviewNotes.editorMenu",
          "when": "resourceScheme == file",
          "group": "codeReviewNotes"
        }
      ],
      "commandPalette": [
        {
          "command": "codeReviewNotes.select",
          "when": "false"
        },
        {
          "command": "codeReviewNotes.openNote",
          "when": "false"
        },
        {
          "command": "codeReviewNotes.viewNote",
          "when": "false"
        },
        {
          "command": "codeReviewNotes.editNote",
          "when": "false"
        },
        {
          "command": "codeReviewNotes.deleteNote",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "submenu": "codeReviewNotes.itemMenu",
          "when": "view == codeReviewNotes.reviews",
          "group": "codeReviewNotes"
        }
      ],
      "codeReviewNotes.itemMenu": [
        {
          "command": "codeReviewNotes.editReview",
          "when": "view == codeReviewNotes.reviews && (viewItem == review)"
        },
        {
          "command": "codeReviewNotes.complete",
          "when": "view == codeReviewNotes.reviews && (viewItem == review)"
        },
        {
          "command": "codeReviewNotes.copy",
          "when": "view == codeReviewNotes.reviews && (viewItem == review || viewItem == completedReview)"
        },
        {
          "command": "codeReviewNotes.export",
          "when": "view == codeReviewNotes.reviews && (viewItem == completedReview)"
        },
        {
          "command": "codeReviewNotes.viewNote",
          "when": "view == codeReviewNotes.reviews && (viewItem == note || viewItem == savedNote)"
        },
        {
          "command": "codeReviewNotes.editNote",
          "when": "view == codeReviewNotes.reviews && (viewItem == note)"
        },
        {
          "command": "codeReviewNotes.deleteNote",
          "when": "view == codeReviewNotes.reviews && (viewItem == note)"
        },
        {
          "command": "codeReviewNotes.addGeneral",
          "when": "view == codeReviewNotes.reviews && viewItem == review"
        }
      ],
      "codeReviewNotes.editorMenu": [
        {
          "command": "codeReviewNotes.start",
          "group": "1_review"
        },
        {
          "command": "codeReviewNotes.add",
          "group": "2_notes"
        },
        {
          "command": "codeReviewNotes.complete",
          "group": "3_export"
        },
        {
          "command": "codeReviewNotes.export",
          "group": "3_export"
        },
        {
          "command": "codeReviewNotes.addGeneral",
          "group": "2_notes"
        }
      ]
    },
    "submenus": [
      {
        "id": "codeReviewNotes.editorMenu",
        "label": "Code Review Note"
      },
      {
        "id": "codeReviewNotes.itemMenu",
        "label": "Code Review Note"
      }
    ]
  },
  "publisher": "alei1180",
  "icon": "media/icon.png",
  "packageManager": "pnpm@11.19.0"
}
